# Install this file as /etc/caddy/Caddyfile on the production server.
# Caddy obtains and renews TLS certificates automatically.

clubmax.ir {
	@enamad path /2268026.txt
	handle @enamad {
		root * /var/www/enamad
		file_server
	}

	@non_enamad not path /2268026.txt
	redir @non_enamad https://www.clubmax.ir{uri} permanent
}

www.clubmax.ir {
	@enamad path /2268026.txt
	handle @enamad {
		root * /var/www/enamad
		file_server
	}

	@api path /v1/* /media/*
	reverse_proxy @api 127.0.0.1:8081
	reverse_proxy 127.0.0.1:3001
}
