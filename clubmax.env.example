# Central network and development configuration for ClubMax.
CLUBMAX_SERVER_IP=127.0.0.1
CLUBMAX_BIND_IP=0.0.0.0
CLUBMAX_PUBLIC_HOST=127.0.0.1
CLUBMAX_FRONTEND_PORT=3001
CLUBMAX_BACKEND_PORT=8081
CLUBMAX_DATABASE_PORT=5433
CLUBMAX_UPLOAD_DIR='../.local/uploads'
CLUBMAX_BACKUP_DIR='../.local/backups'
CLUBMAX_BACKUP_HOURS='6,14,23'
CLUBMAX_BACKUP_RETENTION=42
# Optional fallback when the host pg_dump client is unavailable or incompatible.
CLUBMAX_DATABASE_CONTAINER='clubmax-db'

CLUBMAX_DATABASE_NAME=clubmax
CLUBMAX_DATABASE_USER=clubmax
CLUBMAX_DATABASE_PASSWORD='replace-with-a-strong-database-password'
CLUBMAX_OTP_PEPPER='replace-with-a-long-random-otp-pepper'
CLUBMAX_JWT_SECRET='replace-with-a-long-random-jwt-secret'

CLUBMAX_ADMIN_NAME='مدیر سیستم'
CLUBMAX_ADMIN_USERNAME='admin'
CLUBMAX_ADMIN_PASSWORD='replace-with-a-strong-admin-password'
