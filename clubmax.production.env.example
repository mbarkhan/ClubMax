# Copy to clubmax.production.env, replace every secret, then chmod 600.
CLUBMAX_BIND_IP=0.0.0.0
CLUBMAX_PUBLIC_HOST=SERVER_IP_OR_DOMAIN
CLUBMAX_FRONTEND_PORT=3001
CLUBMAX_BACKEND_PORT=8081
CLUBMAX_FRONTEND_ORIGIN=http://SERVER_IP_OR_DOMAIN:3001
CLUBMAX_PUBLIC_API_URL=http://SERVER_IP_OR_DOMAIN:8081

CLUBMAX_DATABASE_NAME=clubmax
CLUBMAX_DATABASE_USER=clubmax
CLUBMAX_DATABASE_PASSWORD=REPLACE_WITH_A_LONG_RANDOM_PASSWORD
CLUBMAX_OTP_PEPPER=REPLACE_WITH_A_LONG_RANDOM_SECRET
CLUBMAX_JWT_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS

CLUBMAX_ADMIN_NAME=مدیر سیستم
CLUBMAX_ADMIN_USERNAME=admin
CLUBMAX_ADMIN_PASSWORD=REPLACE_WITH_A_STRONG_ADMIN_PASSWORD
